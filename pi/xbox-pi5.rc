# Independent, non-critical late boot service. No existing init file is edited.
service xbox_pi5 /system/bin/sh /data/local/xbox-pi5/supervisor.sh
    class late_start
    user root
    group root usb input uhid
    seclabel u:r:su:s0
    disabled
    restart_period 10

on property:sys.boot_completed=1 && property:persist.vendor.xbox_pi5.enabled=1
    start xbox_pi5

on property:persist.vendor.xbox_pi5.enabled=0
    stop xbox_pi5
